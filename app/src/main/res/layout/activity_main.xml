<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|start"
    android:padding="24dp">

    <!-- Buttons stack top-to-bottom, left-aligned. Add more Button elements
         here later for new features - they'll fall in line below. -->

    <Button
        android:id="@+id/buttonBillChecker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="220dp"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/buttonManage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="220dp"
        android:layout_marginTop="12dp"
        android:text="@string/manage_saved_numbers" />

    <Button
        android:id="@+id/buttonEmergency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="220dp"
        android:layout_marginTop="12dp"
        android:text="@string/emergency_numbers" />

</LinearLayout>
